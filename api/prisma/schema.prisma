// Nomes snake_case: as políticas de RLS em prisma/migrations citam tabelas e colunas em SQL.
// Renomear um @@map quebra aquelas migrações.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Define o artigo usado ao exibir o nome ("o Caetano", "a Elza", "os Titãs").
enum ArticleForm {
  masculino
  feminino
  banda

  @@map("article_form")
}

/// Estado de conservação da mídia, na escala usada pelos sebos brasileiros.
enum Condition {
  lacrado
  excelente
  bom
  regular
  ruim

  @@map("condition")
}

enum AlbumArtistRole {
  principal
  participante

  @@map("album_artist_role")
}

/// Credenciais. Fora do RLS de propósito: o cadastro cria a linha sem sessão. Nunca exposta pela API.
model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  /// Nulo até a pessoa clicar no link do e-mail.
  emailVerifiedAt            DateTime? @map("email_verified_at")
  /// Hash SHA-256 do token. O token em claro só existe no link enviado por e-mail.
  emailVerificationTokenHash String?   @unique @map("email_verification_token_hash")
  emailVerificationExpiresAt DateTime? @map("email_verification_expires_at")

  profile Profile?

  @@map("users")
}

/// Parte pública da conta. Mesmo id de User: as políticas comparam id = current_user_id() sem join.
model Profile {
  id             String    @id @db.Uuid
  username       String    @unique
  displayName    String    @map("display_name")
  bio            String?
  avatarUrl      String?   @map("avatar_url")
  isPublic       Boolean   @default(true) @map("is_public")
  favoriteItemId String?   @map("favorite_item_id") @db.Uuid
  /// Nulo até concluir o onboarding; o front usa isso para decidir entre perguntas e home.
  onboardedAt    DateTime? @map("onboarded_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user         User             @relation(fields: [id], references: [id], onDelete: Cascade)
  items        CollectionItem[]
  favoriteItem CollectionItem?  @relation("FavoriteItem", fields: [favoriteItemId], references: [id], onDelete: SetNull)
  styles       ProfileStyle[]
  artists      ProfileArtist[]

  @@map("profiles")
}

/// Estilos escolhidos no onboarding. Alimentam a ordem das seções da home.
model ProfileStyle {
  profileId String @map("profile_id") @db.Uuid
  styleId   String @map("style_id") @db.Uuid

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  style   Style   @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@id([profileId, styleId])
  @@index([styleId])
  @@map("profile_styles")
}

/// Artistas escolhidos no onboarding. Alimentam a seção "Para você".
model ProfileArtist {
  profileId String @map("profile_id") @db.Uuid
  artistId  String @map("artist_id") @db.Uuid

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  artist  Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([profileId, artistId])
  @@index([artistId])
  @@map("profile_artists")
}

model Artist {
  id          String      @id @default(uuid(7)) @db.Uuid
  /// Id no Discogs. É a chave do upsert do import, para não duplicar a cada busca.
  discogsId   Int         @unique @map("discogs_id")
  name        String
  /// Nome sem artigo inicial, para ordenar "Os Mutantes" em M.
  sortName    String      @map("sort_name")
  articleForm ArticleForm @map("article_form")
  activeFrom  Int?        @map("active_from")
  activeTo    Int?        @map("active_to")
  imageUrl    String?     @map("image_url")

  albums   AlbumArtist[]
  profiles ProfileArtist[]

  @@index([sortName])
  @@map("artists")
}

model Album {
  id               String   @id @default(uuid(7)) @db.Uuid
  title            String
  /// Título normalizado para ordenação alfabética (buildOrderBy usa este).
  sortTitle        String   @map("sort_title")
  releaseYear      Int?     @map("release_year")
  label            String?
  coverUrl         String?  @map("cover_url")
  /// Coletânea de vários artistas: o card mostra "Vários artistas".
  isCompilation    Boolean  @default(false) @map("is_compilation")
  /// Id do release no Discogs. Chave do import: impede duplicar um disco a cada busca.
  discogsReleaseId Int?     @unique @map("discogs_release_id")
  createdAt        DateTime @default(now()) @map("created_at")

  artists         AlbumArtist[]
  styles          AlbumStyle[]
  seriesAlbums    SeriesAlbum[]
  collectionItems CollectionItem[]
  tracks          Track[]

  @@index([sortTitle])
  @@index([label])
  @@index([releaseYear])
  @@map("albums")
}

/// Faixa de um disco, na ordem do Discogs (posições como "A1" ou "B2").
model Track {
  id        String  @id @default(uuid(7)) @db.Uuid
  albumId   String  @map("album_id") @db.Uuid
  position  String
  title     String
  duration  String?
  sortOrder Int     @map("sort_order")

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId, sortOrder])
  @@map("tracks")
}

/// Crédito de artista no disco. `position` preserva a ordem da capa, que não é derivável.
model AlbumArtist {
  albumId  String          @map("album_id") @db.Uuid
  artistId String          @map("artist_id") @db.Uuid
  role     AlbumArtistRole @default(principal)
  position Int             @default(0)

  album  Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([albumId, artistId])
  @@index([artistId])
  @@map("album_artists")
}

model Style {
  id   String @id @default(uuid(7)) @db.Uuid
  /// Usado nos filtros da URL (?estilos=samba,mpb).
  slug String @unique
  name String

  albums   AlbumStyle[]
  profiles ProfileStyle[]

  @@map("styles")
}

model AlbumStyle {
  albumId String @map("album_id") @db.Uuid
  styleId String @map("style_id") @db.Uuid

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  style Style @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@id([albumId, styleId])
  @@index([styleId])
  @@map("album_styles")
}

/// Coleções editoriais (Abril Coleções, Folha Clássicos, caixas de box set).
model Series {
  id   String @id @default(uuid(7)) @db.Uuid
  name String

  albums SeriesAlbum[]

  @@map("series")
}

model SeriesAlbum {
  seriesId String  @map("series_id") @db.Uuid
  albumId  String  @map("album_id") @db.Uuid
  /// Texto livre: há série que numera "Vol. 3" e há série que nomeia.
  volume   String?
  position Int     @default(0)

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  album  Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@id([seriesId, albumId])
  @@index([albumId])
  @@map("series_albums")
}

/// Um disco na estante de alguém. A regra de visibilidade está em CollectionService.
model CollectionItem {
  id         String     @id @default(uuid(7)) @db.Uuid
  ownerId    String     @map("owner_id") @db.Uuid
  albumId    String     @map("album_id") @db.Uuid
  condition  Condition?
  notes      String?
  /// Só a data importa; a hora da compra não diz nada.
  acquiredAt DateTime?  @map("acquired_at") @db.Date
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  owner Profile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  album Album   @relation(fields: [albumId], references: [id], onDelete: Restrict)

  favoritedBy Profile[] @relation("FavoriteItem")

  /// Um disco não entra duas vezes na mesma estante: o P2002 é tratado em CollectionService.add().
  @@unique([ownerId, albumId])
  @@index([ownerId, createdAt])
  @@map("collection_items")
}
