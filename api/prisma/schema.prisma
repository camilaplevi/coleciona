// Coleciona — modelo de dados.
//
// Os nomes de tabela e coluna são snake_case porque as políticas de RLS em
// prisma/migrations são escritas à mão, em SQL, e precisam citar os nomes
// reais. Renomear um @@map aqui quebra aquele arquivo em silêncio.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Define o artigo usado ao exibir o nome ("o Caetano", "a Elza", "os Titãs").
enum ArticleForm {
  masculino
  feminino
  banda

  @@map("article_form")
}

/// Estado de conservação da mídia, na escala usada pelos sebos brasileiros.
enum Condition {
  lacrado
  excelente
  bom
  regular
  ruim

  @@map("condition")
}

enum AlbumArtistRole {
  principal
  participante

  @@map("album_artist_role")
}

// ---------------------------------------------------------------------------
// Conta e perfil
// ---------------------------------------------------------------------------

/// Credenciais. Fica fora do RLS de propósito — ver o comentário na migração
/// de políticas. Nunca é exposta pela API.
model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  profile Profile?

  @@map("users")
}

/// A parte pública da conta. Compartilha o id com User para que as políticas
/// possam comparar `id = current_user_id()` sem um join.
model Profile {
  id             String   @id @db.Uuid
  username       String   @unique
  displayName    String   @map("display_name")
  bio            String?
  avatarUrl      String?  @map("avatar_url")
  isPublic       Boolean  @default(true) @map("is_public")
  favoriteItemId String?  @map("favorite_item_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  user         User             @relation(fields: [id], references: [id], onDelete: Cascade)
  items        CollectionItem[]
  favoriteItem CollectionItem?  @relation("FavoriteItem", fields: [favoriteItemId], references: [id], onDelete: SetNull)

  @@map("profiles")
}

// ---------------------------------------------------------------------------
// Catálogo compartilhado
// ---------------------------------------------------------------------------

model Artist {
  id          String      @id @default(uuid(7)) @db.Uuid
  name        String
  /// Nome sem artigo inicial, para ordenar "Os Mutantes" em M.
  sortName    String      @map("sort_name")
  articleForm ArticleForm @map("article_form")
  activeFrom  Int?        @map("active_from")
  activeTo    Int?        @map("active_to")
  imageUrl    String?     @map("image_url")

  albums AlbumArtist[]

  @@index([sortName])
  @@map("artists")
}

model Album {
  id            String   @id @default(uuid(7)) @db.Uuid
  title         String
  /// Título normalizado para ordenação alfabética (buildOrderBy usa este).
  sortTitle     String   @map("sort_title")
  releaseYear   Int?     @map("release_year")
  label         String?
  coverUrl      String?  @map("cover_url")
  /// Coletânea de vários artistas: o card mostra "Vários artistas".
  isCompilation Boolean  @default(false) @map("is_compilation")
  createdAt     DateTime @default(now()) @map("created_at")

  artists         AlbumArtist[]
  styles          AlbumStyle[]
  seriesAlbums    SeriesAlbum[]
  collectionItems CollectionItem[]

  @@index([sortTitle])
  @@index([label])
  @@index([releaseYear])
  @@map("albums")
}

/// Crédito de artista no disco. `position` preserva a ordem da capa, que não
/// é alfabética nem derivável de nada.
model AlbumArtist {
  albumId  String          @map("album_id") @db.Uuid
  artistId String          @map("artist_id") @db.Uuid
  role     AlbumArtistRole @default(principal)
  position Int             @default(0)

  album  Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([albumId, artistId])
  @@index([artistId])
  @@map("album_artists")
}

model Style {
  id   String @id @default(uuid(7)) @db.Uuid
  /// Usado nos filtros da URL (?estilos=samba,mpb).
  slug String @unique
  name String

  albums AlbumStyle[]

  @@map("styles")
}

model AlbumStyle {
  albumId String @map("album_id") @db.Uuid
  styleId String @map("style_id") @db.Uuid

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  style Style @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@id([albumId, styleId])
  @@index([styleId])
  @@map("album_styles")
}

/// Coleções editoriais (Abril Coleções, Folha Clássicos, caixas de box set).
model Series {
  id   String @id @default(uuid(7)) @db.Uuid
  name String

  albums SeriesAlbum[]

  @@map("series")
}

model SeriesAlbum {
  seriesId String  @map("series_id") @db.Uuid
  albumId  String  @map("album_id") @db.Uuid
  /// Texto livre: há série que numera "Vol. 3" e há série que nomeia.
  volume   String?
  position Int     @default(0)

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  album  Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@id([seriesId, albumId])
  @@index([albumId])
  @@map("series_albums")
}

// ---------------------------------------------------------------------------
// Coleção
// ---------------------------------------------------------------------------

/// Um disco na estante de alguém. A visibilidade é decidida pelo RLS, não por
/// filtro de aplicação — ver CollectionService.
model CollectionItem {
  id         String     @id @default(uuid(7)) @db.Uuid
  ownerId    String     @map("owner_id") @db.Uuid
  albumId    String     @map("album_id") @db.Uuid
  condition  Condition?
  notes      String?
  /// Só a data importa; a hora da compra não diz nada.
  acquiredAt DateTime?  @map("acquired_at") @db.Date
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  owner Profile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  album Album   @relation(fields: [albumId], references: [id], onDelete: Restrict)

  favoritedBy Profile[] @relation("FavoriteItem")

  /// O mesmo disco não entra duas vezes na mesma estante — é este índice que
  /// faz o P2002 tratado em CollectionService.add().
  @@unique([ownerId, albumId])
  @@index([ownerId, createdAt])
  @@map("collection_items")
}
